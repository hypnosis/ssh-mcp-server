# Реальные машины и сырые прогоны: имена, адреса, логины и вывод замеров
# живут здесь и в git не попадают никогда
.private/

# Записи о ходе сессий — локальные, в репозиторий не едут
.remember/

# Обвязка агентов: настройки, worktree-каталоги, слепок версий навыков.
# Локальное окружение разработчика, к пакету отношения не имеет
.agents/
.claude/
skills-lock.json

# Архив замеров приёмки: логи вызовов, наборы кейсов, harness
.acceptance/

# Отчёты о приёмке: содержат подробности боевого сервера, в репозиторий не едут
docs/acceptance/

# Черновики: пишутся по горячим следам, с именами машин и версиями прошивок.
# Причёсанное из них переезжает в BUGLIST и решения — уже обезличенным
docs/drafts/

# Песочница мутационных прогонов
.stryker-tmp/

# Внутренние правила работы команды, для публичной витрины не предназначены
CLAUDE.md

