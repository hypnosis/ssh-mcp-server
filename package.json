{
  "name": "@hypnosis/ssh-mcp-server",
  "version": "2.2.0",
  "mcpName": "io.github.hypnosis/ssh-mcp-server",
  "description": "SSH MCP server for AI agents — remote commands, file transfer, log search and server audits through OpenSSH, with destructive-command checks. Works with Claude Code, Codex, Gemini CLI and any MCP client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ssh-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets/icon-48.png",
    "assets/icon-128.png",
    "assets/icon-512.png",
    "assets/icon-dark-48.png",
    "assets/icon-dark-128.png",
    "assets/icon-dark-512.png",
    "README.md",
    "LICENSE",
    "secrets.json.example"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:live": "SSH_MCP_LIVE=1 vitest run tests/live/",
    "lab:up": "bash scripts/lab-up.sh",
    "test:watch": "vitest",
    "mutate": "node scripts/mutate-changed.mjs",
    "prepublishOnly": "npm run build && npm run test:unit",
    "publish:dry": "npm pack --dry-run",
    "publish:check": "npm pack && tar -tzf *.tgz | head -20 && rm -f *.tgz",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "^6.15.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ssh",
    "openssh",
    "scp",
    "sftp",
    "remote-server",
    "server-management",
    "devops",
    "sysadmin",
    "logs",
    "audit",
    "claude",
    "claude-code",
    "codex",
    "gemini-cli",
    "hermes",
    "ai-agent",
    "ssh-mcp",
    "ssh-mcp-server",
    "remote-ssh",
    "claude-code-mcp",
    "codex-cli",
    "server-audit",
    "log-search"
  ],
  "author": "hypnosis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypnosis/ssh-mcp-server.git"
  },
  "homepage": "https://github.com/hypnosis/ssh-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/hypnosis/ssh-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
