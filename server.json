{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hypnosis/ssh-mcp-server",
  "title": "SSH MCP Server",
  "description": "Modern SSH for AI agents — cloud servers to BusyBox routers, with destructive commands blocked.",
  "repository": {
    "url": "https://github.com/hypnosis/ssh-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/hypnosis/ssh-mcp-server#readme",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/hypnosis/ssh-mcp-server/main/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/hypnosis/ssh-mcp-server/main/assets/icon-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ],
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/hypnosis/ssh-mcp-server/main/assets/icon-48.png",
      "mimeType": "image/png",
      "sizes": [
        "48x48"
      ],
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/hypnosis/ssh-mcp-server/main/assets/icon-dark-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ],
      "theme": "dark"
    },
    {
      "src": "https://raw.githubusercontent.com/hypnosis/ssh-mcp-server/main/assets/icon-dark-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ],
      "theme": "dark"
    },
    {
      "src": "https://raw.githubusercontent.com/hypnosis/ssh-mcp-server/main/assets/icon-dark-48.png",
      "mimeType": "image/png",
      "sizes": [
        "48x48"
      ],
      "theme": "dark"
    }
  ],
  "version": "2.2.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@hypnosis/ssh-mcp-server",
      "version": "2.2.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SSH_PROFILES_FILE",
          "description": "Absolute path to the JSON file describing the servers this agent may reach.",
          "isRequired": true,
          "isSecret": false,
          "format": "filepath"
        },
        {
          "name": "SSH_MCP_LOG_LEVEL",
          "description": "Log verbosity: error, warn, info or debug. Defaults to info.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
